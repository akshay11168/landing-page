---
import { stats } from "../content/site";
---

<section class="stats-band" aria-label="Experience">
  <div class="wrap">
    <ul class="stats">
      {
        stats.map((stat) => (
          <li>
            <p class="stat-figure">
              <span class="stat-value" data-count={stat.value} data-suffix={stat.suffix}>{stat.display}</span>
              {stat.detail && <span class="stat-unit">{stat.label}</span>}
            </p>
            <p class="stat-text">{stat.detail ?? stat.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
