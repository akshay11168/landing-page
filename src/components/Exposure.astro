---
import SectionHeading from "./SectionHeading.astro";
import { exposure } from "../content/site";
---

<section class="section" id="exposure" aria-labelledby="exposure-title">
  <div class="wrap">
    <SectionHeading
      id="exposure-title"
      title="Global Exposure and Cross-Industry Expertise, Applied to Your Business."
      singleLine
      tight
    />
    <div class="logo-marquee">
      <div class="logo-track">
        <ul class="logo-row">
          {
            exposure.map((logo) => (
              <li>
                <img src={logo.src} alt={logo.alt} />
              </li>
            ))
          }
        </ul>
        <ul class="logo-row" aria-hidden="true">
          {
            exposure.map((logo) => (
              <li>
                <img src={logo.src} alt="" />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
