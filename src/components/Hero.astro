---
import { hero } from "../content/site";

const splitAt = hero.title.indexOf(". ");
const lineOne = splitAt === -1 ? hero.title : hero.title.slice(0, splitAt + 1);
const lineTwo = splitAt === -1 ? "" : hero.title.slice(splitAt + 2);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title">
        <span class="hero-line">{lineOne}</span>
        {lineTwo && <span class="hero-line">{lineTwo}</span>}
      </h1>
      <p class="promise">{hero.promise}</p>
      <p class="lede">{hero.lede}</p>
      <div class="actions">
        <a class="button" href="/#services" data-track="cta_click" data-track-location="hero">{hero.primaryCta}</a>
        <a class="button secondary" href="/#contact" data-track="cta_click" data-track-location="hero-contact">{hero.secondaryCta}</a>
      </div>
    </div>
    <div class="horizon-frame">
      <figure class="horizon">
        <img class="horizon-glow" src="/elements/glow.png" alt="" />
        <img class="horizon-earth" src="/elements/earth.png" alt="" />
        <img class="horizon-rays" src="/elements/rays.png" alt="" />
        <figcaption class="sr-only">Light rising over the curve of the earth.</figcaption>
      </figure>
    </div>
  </div>
</section>
