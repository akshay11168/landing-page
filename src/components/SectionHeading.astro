---
interface Props {
  title: string;
  id: string;
  lede?: string;
  singleLine?: boolean;
  /** Shrink a long one-line heading so it still fits the row. */
  tight?: boolean;
}

const { title, id, lede, singleLine = false, tight = false } = Astro.props;
---

<div class="section-heading">
  <h2 id={id} class:list={{ "single-line": singleLine, tight }}>{title}</h2>
  {lede && <p class="lede">{lede}</p>}
</div>
