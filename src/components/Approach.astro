---
import SectionHeading from "./SectionHeading.astro";
import { engagements } from "../content/site";
---

<section class="section" id="approach" aria-labelledby="approach-title">
  <div class="wrap">
    <SectionHeading
      id="approach-title"
      title="Ways To Work Together"
      lede="Whatever stage you're at, there's a way forward."
    />
    <ul class="way-list">
      {
        engagements.map((item) => (
          <li class="flip" tabindex="0">
            <div class="flip-inner">
              <div class="flip-face flip-front stack">
                <h3>{item.title}</h3>
              </div>
              <div class="flip-face flip-back stack">
                <p>{item.body}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="actions">
      <a class="button" href="/#contact" data-track="cta_click" data-track-location="approach">Let’s Find Your Fit</a>
    </p>
  </div>
</section>
