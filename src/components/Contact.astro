---
import { contactCopy, contactTopics, site } from "../content/site";

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const usesProvider = accessKey.trim().length > 0;
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap contact-grid">
    <div>
      <p class="index-row">
        <span class="index">07</span>
      </p>
      <h2 id="contact-title">Is the software keeping up with the product?</h2>
      <p class="lede">
        Tell me where it is straining. A short description is enough to see whether I can help, and what a sensible first scope would be.
      </p>
      <p>
        <a class="mail-link" data-track="email_click" href={`mailto:${site.email}`}>Email {site.email}</a>
      </p>
      <p class="privacy">{contactCopy.reply}</p>
      <p class="privacy">
        {contactCopy.faster}{" "}
        <a data-track="email_click" href={`mailto:${site.directEmail}`}>{site.directEmail}</a>,{" "}
        <a href={`tel:${site.phoneTel}`}>call {site.phoneDisplay}</a>, or{" "}
        <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">
          WhatsApp<span class="sr-only"> (opens in a new tab)</span>
        </a>{" "}
        the same number.
      </p>
      {!usesProvider && <p class="privacy">{contactCopy.mailtoNote}</p>}
    </div>
    <form
      class="enquiry"
      data-enquiry
      data-email={site.email}
      data-from-name={`${site.brandName} website`}
      method="post"
      action={usesProvider ? "https://api.web3forms.com/submit" : `mailto:${site.email}`}
      enctype={usesProvider ? "application/x-www-form-urlencoded" : "text/plain"}
    >
      {
        usesProvider && (
          <input type="hidden" name="access_key" value={accessKey} />
        )
      }
      <input type="hidden" name="subject" value="Project enquiry from www.biradarakshay.com" />
      <input type="hidden" name="from_name" value={`${site.brandName} website`} />
      <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
      <div class="hp" aria-hidden="true" inert>
        <label>
          Leave this blank
          <input type="text" name="hp_field" tabindex="-1" autocomplete="off" data-honeypot />
        </label>
      </div>

      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required maxlength="120" />
        <p id="name-error" class="field-error" data-error data-error-for="name" hidden></p>
      </div>
      <div class="field">
        <label for="email">Work email</label>
        <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" />
        <p id="email-error" class="field-error" data-error data-error-for="email" hidden></p>
      </div>
      <div class="field">
        <label for="company">Company or product <span class="optional">(optional)</span></label>
        <input id="company" name="company" type="text" autocomplete="organization" maxlength="160" />
        <p id="company-error" class="field-error" data-error data-error-for="company" hidden></p>
      </div>
      <div class="field">
        <label for="topic">What do you need help with?</label>
        <select id="topic" name="topic" required>
          <option value="">Select one</option>
          {contactTopics.map((topic) => <option value={topic.value}>{topic.label}</option>)}
        </select>
        <p id="topic-error" class="field-error" data-error data-error-for="topic" hidden></p>
      </div>
      <div class="field">
        <label for="message">Brief project or problem description</label>
        <textarea id="message" name="message" required maxlength="4000" rows="5"></textarea>
        <p id="message-error" class="field-error" data-error data-error-for="message" hidden></p>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="phone">Phone <span class="optional">(optional)</span></label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="30" />
          <p id="phone-error" class="field-error" data-error data-error-for="phone" hidden></p>
        </div>
        <div class="field">
          <label for="budget">Budget or timeline <span class="optional">(optional)</span></label>
          <input id="budget" name="budget" type="text" maxlength="200" />
          <p id="budget-error" class="field-error" data-error data-error-for="budget" hidden></p>
        </div>
      </div>
      <p id="form-status" class="form-status" data-status tabindex="-1" hidden></p>
      <button class="button" type="submit" data-submit>
        {usesProvider ? "Send enquiry" : "Open this enquiry in email"}
      </button>
    </form>
  </div>
  <dialog class="received" data-received aria-labelledby="received-title">
    <h2 id="received-title">{contactCopy.receivedTitle}</h2>
    <p>{contactCopy.receivedBody}</p>
    <p>
      {contactCopy.faster}{" "}
      <a data-track="email_click" href={`mailto:${site.directEmail}`}>{site.directEmail}</a>,{" "}
      <a href={`tel:${site.phoneTel}`}>call {site.phoneDisplay}</a>, or{" "}
      <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">
        WhatsApp<span class="sr-only"> (opens in a new tab)</span>
      </a>{" "}
      the same number.
    </p>
    <button class="button" type="button" data-received-close>Close</button>
  </dialog>
</section>

<script>
  import { bindEnquiryForm } from "../scripts/enquiry-form";

  bindEnquiryForm(import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "");
</script>
