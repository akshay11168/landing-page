---
import SectionHeading from "./SectionHeading.astro";
import { offerings } from "../content/site";
---

<section class="section" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <SectionHeading
      id="services-title"
      title="Whatever The Gap, We'll Help You Bridge It."
      lede="Your ambition deserves a flexible ecosystem."
      singleLine
    />
    <div class="offering-grid">
      {
        offerings.map((offering) => (
          <article class="flip offering" id={offering.id} tabindex="0" aria-labelledby={`offering-${offering.id}`}>
            <div class="flip-inner">
              <div class="flip-face flip-front stack">
                <h3 id={`offering-${offering.id}`}>{offering.name}</h3>
                <p class="service-problem">{offering.summary}</p>
              </div>
              <div class="flip-face flip-back">
                <p class="flip-kicker">{offering.name}</p>
                <ul>
                  {offering.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
    <p class="actions">
      <a class="button" href="/#contact" data-track="cta_click" data-track-location="services">Discuss The Challenges</a>
    </p>
  </div>
</section>
