---
import SectionHeading from "./SectionHeading.astro";
import { projectPath, projects } from "../content/site";

const ordered = [...projects].sort((a, b) => {
  const withDemo = Number(Boolean(b.href)) - Number(Boolean(a.href));
  return withDemo !== 0 ? withDemo : a.sortOrder - b.sortOrder;
});
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <SectionHeading
      id="work-title"
      title="Solutions in Action: Selected Projects"
      singleLine
    />
    <div class="work-rail">
      <button type="button" class="work-arrow" data-work-dir="-1" data-track="project_scroll" data-track-location="previous" aria-label="Show earlier projects" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M14.5 5.5 8 12l6.5 6.5" />
        </svg>
      </button>
      <ol class="work-scroller">
      {
        ordered.map((project) => (
          <li>
            <a
              class="work-card"
              href={projectPath(project.slug)}
              data-track="project_click"
              data-track-project={project.slug}
            >
              <img class="work-thumb" src={encodeURI(project.image)} alt="" />
              <h3>{project.title}</h3>
              <p>{project.line}</p>
            </a>
          </li>
        ))
      }
      </ol>
      <button type="button" class="work-arrow" data-work-dir="1" data-track="project_scroll" data-track-location="next" aria-label="Show more projects">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9.5 5.5 16 12l-6.5 6.5" />
        </svg>
      </button>
    </div>
  </div>
</section>
