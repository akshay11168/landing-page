---
import SectionHeading from "./SectionHeading.astro";
import { problems } from "../content/site";
---

<section class="section" aria-labelledby="problems-title">
  <div class="wrap">
    <SectionHeading
      id="problems-title"
      title="What's Standing In Your Way?"
      lede="Ambitions are high. Constraints are real."
      singleLine
    />
    <ul class="problem-list">
      {problems.map((problem) => (
        <li>
          <img src={problem.image} alt="" width="64" height="64" />
          <h3>{problem.text}</h3>
        </li>
      ))}
    </ul>
  </div>
</section>
