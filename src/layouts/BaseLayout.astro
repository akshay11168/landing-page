---
import "@fontsource-variable/fraunces";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../content/site";
import { structuredDataJson } from "../lib/seo";

const beacon = import.meta.env.PUBLIC_CLOUDFLARE_BEACON_TOKEN?.trim() ?? "";
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim() ?? "";
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC?.trim() || "https://cloud.umami.is/script.js";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const image = new URL("/og.svg", site.url).href;
const imageAlt = `${site.brandName}. ${site.tagline}`;
const robots = noindex
  ? "noindex, follow"
  : "index, follow, max-image-preview:large, max-snippet:-1";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.brandName} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Plain-text summary of this site" />
    <link rel="me" href={site.linkedin} />
    <link rel="me" href={site.github} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f4f1ea" />
    <meta property="og:site_name" content={site.brandName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!noindex && <script type="application/ld+json" set:html={structuredDataJson()} />}
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="stripe" aria-hidden="true"><span></span><span></span><span></span></div>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <script>
      import { bindAnalytics } from "../scripts/analytics";
      bindAnalytics();
    </script>
    {
      beacon && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beacon })}
        />
      )
    }
    {
      umamiId && (
        <script defer src={umamiSrc} data-website-id={umamiId} data-domains="www.biradarakshay.com" />
      )
    }
  </body>
</html>
