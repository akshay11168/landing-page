# Public Web3Forms access key. Web3Forms expects this key in the browser,
# so a production build will include it in the page. It is still not a
# password: do not commit a real key. Leave this blank until the key exists.
#
# 1. Create a key at https://web3forms.com for enquiry@biradarakshay.com
# 2. Confirm that inbox from the Web3Forms verification email
# 3. Paste the key here for local builds
# 4. For GitHub Pages, set the same value as an Actions secret named
#    PUBLIC_WEB3FORMS_ACCESS_KEY
#
# While this is blank, the contact form opens the visitor's email app
# instead of claiming the message was sent.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Cookieless page analytics. Leave blank until the token exists.
# Cloudflare dashboard → Web Analytics → your site → Manage site → JS snippet token.
# The token is public in the page, like the Web3Forms key. Do not commit it.
# Add the same name as an Actions secret, then re-run the deploy.
PUBLIC_CLOUDFLARE_BEACON_TOKEN=

# Optional. Umami records the custom events Cloudflare Web Analytics does not:
# project_click, cta_click, enquiry_start, enquiry_success, email_click.
# Umami Cloud website id, or a self-hosted website id. Leave blank to skip.
PUBLIC_UMAMI_WEBSITE_ID=
# Only set this for a self-hosted Umami script. The default is Umami Cloud.
PUBLIC_UMAMI_SRC=
