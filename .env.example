# Public Web3Forms access key. Web3Forms expects this key in the browser,
# so a production build will include it in the page. It is still not a
# password: do not commit a real key. Leave this blank until the key exists.
#
# 1. Create a key at https://web3forms.com for enquiry@biradarakshay.com
# 2. Confirm that inbox from the Web3Forms verification email
# 3. Paste the key here for local builds
# 4. For GitHub Pages, set the same value as an Actions secret named
#    PUBLIC_WEB3FORMS_ACCESS_KEY
#
# While this is blank, the contact form opens the visitor's email app
# instead of claiming the message was sent.
PUBLIC_WEB3FORMS_ACCESS_KEY=
